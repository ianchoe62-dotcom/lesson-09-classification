        "의사결정트리(질문으로 답하는 모델)",
        "입력을 하나도 보지 않는 모델"
    ]
)

if "로지스틱" in model_choice:
    current_preds = y_pred_lr
    fn_val = cm_lr[2]
    fp_val = cm_lr[1]
elif "의사결정트리" in model_choice:
    current_preds = y_pred_dt
    fn_val = cm_dt[2]
    fp_val = cm_dt[1]
else:
    current_preds = y_pred_base
    fn_val = cm_base[2]
    fp_val = cm_base[1]

# 테스트 데이터프레임에 예측 결과 및 인덱스 부여
test_analysis_df = test_df.copy()
test_analysis_df['pred'] = current_preds

# 1. 실제 뇌졸중(1)인데 아니라고(0) 예측한 사람 (FN: 놓친 환자)
missed_patients = test_analysis_df[(test_analysis_df['stroke'] == 1) & (test_analysis_df['pred'] == 0)].copy()

# 2. 실제 아님(0)인데 뇌졸중(1)이라고 예측한 사람 (FP: 헛짚은 사람)
false_alarm_patients = test_analysis_df[(test_analysis_df['stroke'] == 0) & (test_analysis_df['pred'] == 1)].copy()

# 나이 많은 순서 정렬
missed_patients = missed_patients.sort_values(by='age', ascending=False)
false_alarm_patients = false_alarm_patients.sort_values(by='age', ascending=False)

col_list1, col_list2 = st.columns(2)

display_columns = ['age', 'avg_glucose_level', 'hypertension', 'heart_disease']
column_rename_map = {
